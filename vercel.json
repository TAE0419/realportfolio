{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix portfolio",
  "buildCommand": "npm run build",
  "outputDirectory": "portfolio/dist",
  "rewrites": [
    { "source": "/frontend", "destination": "/index.html" },
    { "source": "/industrial-design", "destination": "/index.html" },
    { "source": "/project/:path*", "destination": "/index.html" }
  ]
}
